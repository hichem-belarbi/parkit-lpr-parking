# --- Serveur (réseau local) ---
PARKIT_SERVER_IP=192.168.1.50
PARKIT_SERVER_PORT=80
PARKIT_API_PATH=/parknova-frontend/api/access_checker.php
PARKIT_API_SCHEME=http
PARKIT_API_KEY=change_me_same_as_config_php
PARKIT_API_TIMEOUT=3

# --- Broches GPIO (numérotation BCM) : à adapter à ton câblage ---
PARKIT_IR1_PIN=17
PARKIT_IR2_PIN=27
PARKIT_SERVO_PIN=18

# --- Capteurs IR ---
# true  : le capteur passe à LOW quand il détecte (cas le plus courant)
# false : le capteur passe à HIGH quand il détecte
PARKIT_IR_ACTIVE_LOW=true

# --- Servomoteur / barrière ---
PARKIT_SERVO_CLOSED_ANGLE=0
PARKIT_SERVO_OPEN_ANGLE=90
PARKIT_WAIT_IR2_TIMEOUT=30
PARKIT_CLOSE_DELAY=2
